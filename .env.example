# Local development only. Use Supabase Dashboard -> Connect to obtain the connection details.
# Prefer the Session Pooler connection string if your network cannot use the direct database host.
# Keep real credentials in your local environment; never commit them.
SIAM_DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
SIAM_DB_USER=YOUR_DATABASE_USER
SIAM_DB_PASSWORD=YOUR_DATABASE_PASSWORD
